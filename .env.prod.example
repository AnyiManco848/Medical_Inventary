# Variables de docker-compose.prod.yml (EC2).
# En la EC2: copia este archivo como /opt/medical-inventary/.env, reemplaza cada <TU_...> y protégelo:
#   cp .env.prod.example .env && chmod 600 .env
#   bash scripts/env/check-env.sh .env .env.prod.example    (dice qué falta sin mostrar valores)
# NUNCA subas el .env real al repositorio.
# No uses el carácter "$" en los valores (Docker Compose lo interpreta): usa claves en hexadecimal.
# Guía completa: docs/ENV.md

# --- Dominio (DuckDNS) ---
# Dominio completo, sin https:// y sin "/" final. Ej.: mi-inventario.duckdns.org
DOMAIN=<TU_SUBDOMINIO>.duckdns.org
# Correo para avisos de Let's Encrypt (vencimiento de certificados)
ACME_EMAIL=<TU_CORREO>
# Solo el subdominio (sin .duckdns.org) y el token de tu cuenta (secreto).
# Ambos aparecen en https://www.duckdns.org al iniciar sesión. Los usa update-duckdns.sh.
DUCKDNS_SUBDOMAIN=<TU_SUBDOMINIO>
DUCKDNS_TOKEN=<TU_TOKEN_DE_DUCKDNS>

# --- Imágenes en ECR ---
AWS_REGION=us-east-1
# <ID_DE_CUENTA>.dkr.ecr.<REGION>.amazonaws.com. El ID de cuenta (12 dígitos) sale de:
#   aws sts get-caller-identity --query Account --output text
ECR_REGISTRY=<TU_AWS_ACCOUNT_ID>.dkr.ecr.us-east-1.amazonaws.com
ECR_BACKEND_REPO=medical-inventary-backend
ECR_FRONTEND_REPO=medical-inventary-frontend
# Etiqueta publicada por deploy/aws/build-push-*.ps1 (latest o el commit corto)
IMAGE_TAG=latest

# --- Base de datos (contenedor db) ---
DB_NAME=MedicalInventary
DB_USER=medinv
# Secreto. Genera una con:
#   bash:       openssl rand -hex 24
#   PowerShell: $b = New-Object byte[] 24; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | % { $_.ToString('x2') })
DB_PASSWORD=<TU_CONTRASENA_DE_BD>

# --- Backend ---
# Secreto. Genera uno con:
#   bash:       openssl rand -hex 32
#   PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | % { $_.ToString('x2') })
JWT_SECRET=<TU_JWT_SECRET>
JWT_EXPIRES_IN=8h
# Deja false. Para inicializar la base usa: docker compose ... run --rm backend node src/config/initDB.js
AUTO_INIT=false

# NEXT_PUBLIC_API_URL no va aquí: queda dentro de la imagen del frontend al construirla
# (deploy/aws/build-push-frontend.ps1). En esta arquitectura es https://<DOMAIN>.
