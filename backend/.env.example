# Variables del backend (desarrollo local con `npm run dev` / `npm start`).
# 1. Copia este archivo como backend/.env   (Windows: copy .env.example .env · bash: cp .env.example .env)
# 2. Reemplaza cada marcador <TU_...> por el valor real.
# 3. Comprueba que no quedó nada sin llenar (sin mostrar valores):
#      PowerShell: ..\scripts\env\check-env.ps1 .env
#      bash:       ../scripts/env/check-env.sh .env
# NUNCA subas el archivo .env al repositorio (está en .gitignore).
# Guía completa: docs/ENV.md

# --- Servidor ---
# Puerto HTTP del backend. Por defecto 4000.
PORT=4000
# development muestra el SQL en consola y el stack de los errores en las respuestas.
# En producción usa production.
NODE_ENV=development

# Origen permitido por CORS: la URL del frontend, sin "/" al final.
# Local: http://localhost:3000 · Producción: la URL HTTPS pública del frontend.
FRONTEND_URL=http://localhost:3000

# --- Base de datos (PostgreSQL) ---
# Opción 1 (nube: Neon, RDS, Render...): cadena de conexión completa. Si está definida,
# se ignoran las DB_* de abajo y la conexión usa SSL. Se copia del panel del proveedor.
# DATABASE_URL=postgresql://<TU_USUARIO>:<TU_CONTRASENA>@<TU_HOST>/<TU_BASE>?sslmode=require

# Opción 2 (PostgreSQL local o en Docker).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=MedicalInventary
# Usuario y contraseña que creaste al instalar PostgreSQL (secreto: DB_PASSWORD).
DB_USER=<TU_USUARIO_POSTGRES>
DB_PASSWORD=<TU_CONTRASENA_POSTGRES>

# --- Autenticación (secreto) ---
# Clave para firmar los tokens JWT. Larga y aleatoria; si cambia, todas las sesiones se cierran.
# Genérala con cualquiera de estas opciones:
#   bash / Git Bash:   openssl rand -hex 32
#   Node (cualquier SO): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   PowerShell:        $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | % { $_.ToString('x2') })
JWT_SECRET=<TU_JWT_SECRET>
# Duración de la sesión (formato de jsonwebtoken: 8h, 30m, 1d).
JWT_EXPIRES_IN=8h

# --- Inicialización automática al arrancar ---
# true ejecuta initDB + seedAdmin en cada arranque. initDB BORRA usuarios y trazabilidad:
# déjalo en false y usa `npm run db:init` solo sobre una base nueva.
AUTO_INIT=false

# --- Prueba de saturación (opcional, solo para `npm run test:saturacion`) ---
# Ver backend/tests/README.md. Úsala contra una base de PRUEBAS.
# SAT_URL=http://localhost:4000
# SAT_USER=<TU_USUARIO_ADMIN_DE_PRUEBAS>
# SAT_PASS=<TU_CONTRASENA_ADMIN_DE_PRUEBAS>
