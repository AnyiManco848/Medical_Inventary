# Referencia para builds de producción. Next.js fija NEXT_PUBLIC_* al compilar (no se lee en runtime).
# Sin "/" ni "/api" al final: el código añade "/api/..." a cada petición.
# En Docker se pasa como build-arg (ya definido en docker-compose.yml y en frontend/Dockerfile).
NEXT_PUBLIC_API_URL=https://medicalinventary.duckdns.org
